# Convenience Store Infrastructure Configuration
# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PostgresSecret123!
POSTGRES_DB=convenience_store_db
POSTGRES_PORT=5432

# Cache & Distributed Lock (Redis)
REDIS_PASSWORD=RedisSecret123!
REDIS_PORT=6379

# Database Admin UI (pgAdmin)
PGADMIN_DEFAULT_EMAIL=admin@conveniencestore.com
PGADMIN_DEFAULT_PASSWORD=AdminSecret123!
PGADMIN_PORT=5050
